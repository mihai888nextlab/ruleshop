{
  "name": "ruleshop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n storefront,control-plane -c cyan,magenta \"npm:dev:storefront\" \"npm:dev:control-plane\"",
    "dev:storefront": "npm run dev --workspace @ruleshop/storefront",
    "dev:control-plane": "npm run dev --workspace @ruleshop/control-plane",
    "build": "npm run build --workspace @ruleshop/control-plane && npm run build --workspace @ruleshop/storefront",
    "start": "concurrently -n storefront,control-plane -c cyan,magenta \"npm:start:storefront\" \"npm:start:control-plane\"",
    "start:storefront": "npm run start --workspace @ruleshop/storefront",
    "start:control-plane": "npm run start --workspace @ruleshop/control-plane",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:push": "npm run db:push --workspace @ruleshop/control-plane",
    "db:seed": "npm run db:seed --workspace @ruleshop/control-plane",
    "db:reset": "npm run db:reset --workspace @ruleshop/control-plane",
    "postinstall": "npm run prisma:generate --workspace @ruleshop/control-plane"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
