generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  OPERATOR
  STORE_ADMIN
  PLATFORM_ADMIN
}

enum RulesetStatus {
  draft
  published
  canary
  archived
}

enum DecisionType {
  pricing
  shipping
  fraud
  availability
  loyalty
  theme
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
  BLOCKED
}

enum AiSuggestionStatus {
  pending
  approved
  rejected
}

/// Data types an administrator can give a customer attribute. Mirrors FieldType
/// in @ruleshop/engine, which decides valid operators per type.
enum AttributeType {
  string
  number
  boolean
  enum
  date
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Kill switches. These are operational overrides, deliberately stored on the
  /// store rather than inside a ruleset: a published version stays immutable so
  /// it remains auditable and restorable, so "turn this off now" must not
  /// require editing it.
  ///
  /// Category map: decision type -> true means disabled.
  killSwitchCategories Json    @default("{}")
  /// Store-wide switch stopping all rule evaluation.
  killSwitchEnabled    Boolean @default(false)
  /// Individual rule keys taken out of service.
  killedRuleKeys       Json    @default("[]")
  /// Ruleset versions refused at resolution time.
  killedVersions       Json    @default("[]")

  memberships   Membership[]
  products      Product[]
  carts         Cart[]
  orders        Order[]
  rulesets      Ruleset[]
  deployment    Deployment?
  evaluations   Evaluation[]
  auditLogs     AuditLog[]
  aiSuggestions AiSuggestion[]
  attributeDefs CustomerAttributeDef[]
  profiles      CustomerProfile[]
  themes        Theme[]
}

/// A visual theme composed by an administrator.
///
/// Themes are data rather than code: a `setTheme` rule names one by key, and the
/// storefront applies its tokens as CSS custom properties. Adding a look, or
/// changing which customers see it, needs no deploy.
model Theme {
  id      String @id @default(cuid())
  storeId String
  /// Referenced by setTheme rules. Immutable once rules may point at it.
  key     String
  name    String
  /// Design tokens, validated against themeTokensSchema before every write.
  /// Colours are hex literals and fonts are keys into a set the storefront has
  /// already loaded, so a theme cannot inject CSS.
  tokens  Json
  /// Applied when no rule expresses a preference. At most one per store.
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId, isDefault])
}

/// An administrator-defined customer field.
///
/// Each definition adds a typed variable to this store's rule vocabulary at
/// `customer.attributes.<key>`, offered in the rule editor with only the
/// operators its type allows, and rendered on the storefront profile form so
/// customers can supply the value. Adding a segmentation dimension therefore
/// needs no code change and no deploy.
model CustomerAttributeDef {
  id            String        @id @default(cuid())
  storeId       String
  /// Slug used in rule paths. Immutable once rules may reference it.
  key           String
  label         String
  description   String        @default("")
  type          AttributeType
  /// Allowed values for `enum` attributes; empty for every other type.
  options       Json          @default("[]")
  required      Boolean       @default(false)
  /// Whether customers see and fill this field on their profile.
  showOnProfile Boolean       @default(true)
  /// Ordering in the profile form and the editor palette.
  position      Int           @default(0)
  /// Archived attributes keep stored values and stay readable by existing
  /// rules, but are no longer offered for new ones. Deleting a referenced
  /// attribute is refused outright.
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@index([storeId, archived, position])
}

/// Values a customer supplied for one store's attribute definitions.
///
/// Scoped by store, so a shopper's profile in one shop is invisible to another
/// even though the underlying account is shared.
model CustomerProfile {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  /// Map of attribute key to value, validated against the store's definitions
  /// before every write.
  values    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  /// Platform-level role; store roles live on Membership
  platformRole Role?
  loyaltyPoints Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  carts       Cart[]
  orders      Order[]
  auditLogs   AuditLog[]
  aiSuggestions AiSuggestion[]
  profiles    CustomerProfile[]
}

model Membership {
  id        String   @id @default(cuid())
  storeId   String
  userId    String
  role      Role
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  slug        String
  name        String
  description String   @default("")
  category    String   @default("general")
  basePrice   Decimal  @db.Decimal(12, 2)
  stock       Int      @default(0)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId, category])
}

model Cart {
  id        String   @id @default(cuid())
  storeId   String
  userId    String?
  guestId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([storeId, userId])
  @@index([storeId, guestId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  userId          String?
  guestEmail      String?
  /// Caller-supplied token making checkout idempotent. A retried or
  /// double-submitted request returns the original order instead of placing a
  /// second one. Unique per store so tokens cannot collide across tenants.
  idempotencyKey  String?
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0) @db.Decimal(12, 2)
  shippingMethod  String?
  total           Decimal     @db.Decimal(12, 2)
  loyaltyPointsEarned Int     @default(0)
  decisionTrace   Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, userId])
  @@index([storeId, createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Ruleset {
  id        String        @id @default(cuid())
  storeId   String
  version   Int
  status    RulesetStatus @default(draft)
  name      String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  createdBy String?

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rules       Rule[]
  evaluations Evaluation[]

  @@unique([storeId, version])
  @@index([storeId, status])
}

model Rule {
  id          String       @id @default(cuid())
  rulesetId   String
  key         String
  name        String
  description String       @default("")
  category    DecisionType
  priority    Int          @default(100)
  enabled     Boolean      @default(true)
  conditions  Json
  actions     Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ruleset Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Cascade)

  @@unique([rulesetId, key])
  @@index([rulesetId, category, priority])
}

model Deployment {
  id             String  @id @default(cuid())
  storeId        String  @unique
  stableVersion  Int?
  canaryVersion  Int?
  canaryPercent  Int     @default(0)
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id              String       @id @default(cuid())
  storeId         String
  rulesetId       String?
  rulesetVersion  Int?
  decisionType    DecisionType
  subjectKey      String?
  context         Json
  decision        Json
  matchedRules    Json
  explanation     Json
  warnings        Json         @default("[]")
  isCanary        Boolean      @default(false)
  createdAt       DateTime     @default(now())

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ruleset Ruleset? @relation(fields: [rulesetId], references: [id], onDelete: SetNull)

  @@index([storeId, decisionType, createdAt])
  @@index([storeId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
}

model AiSuggestion {
  id          String             @id @default(cuid())
  storeId     String
  userId      String?
  kind        String
  prompt      String?
  proposal    Json
  metrics     Json?
  confidence  Float?
  status      AiSuggestionStatus @default(pending)
  reviewNote  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  /// Traceability for every AI evaluation. Which model produced this, under
  /// which prompt revision, how long it took, and what it actually returned —
  /// so a suggestion acted on months ago can still be accounted for, and a
  /// change in model or prompt is visible rather than silent.
  model         String?
  promptVersion String?
  latencyMs     Int?
  tokensPrompt  Int?
  tokensOutput  Int?
  /// The model's unparsed reply, kept because a suggestion is only auditable if
  /// the original text can be re-read rather than just its parsed result.
  rawResponse   String?
  /// Findings and statistics computed by this application, kept separate from
  /// anything the model said so the two can never be confused.
  analysis      Json?
  /// Rule this suggestion is about, when it targets an existing one.
  targetRuleKey String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
}
