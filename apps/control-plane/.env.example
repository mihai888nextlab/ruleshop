# Control plane — the only app with database access.
# Copy to apps/control-plane/.env and fill in. Never commit the result.

# Postgres from docker-compose.yml at the repo root
DATABASE_URL="postgresql://ruleshop:ruleshop@localhost:5432/ruleshop?schema=public"

# Signs staff session cookies for the control-plane UI. Use a long random value:
#   openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Signs the bearer tokens the storefront presents on behalf of customers.
# Must be different from AUTH_SECRET so a leaked customer token cannot be
# replayed against staff routes.
STOREFRONT_JWT_SECRET="change-me-to-a-different-long-random-string"

# Origins allowed to call the storefront-facing API — comma-separated.
# One entry per running storefront: each shop is its own deployment on its own
# origin, and a browser blocks any origin missing from this list.
#   STOREFRONT_ORIGIN="http://localhost:3008,http://localhost:3009,https://shop.example"
# "*" allows any origin (development only).
STOREFRONT_ORIGIN="http://localhost:3008"

# Public control-plane URL embedded in clone instructions for the Vite SPA.
CONTROL_PLANE_PUBLIC_URL="http://localhost:3001"

# Degit path shown after creating a store (owner/repo/apps/storefront).
RULESHOP_DEGIT_SOURCE="mihai/ruleshop/apps/storefront"

# Published storefront Docker image shown in connection instructions.
RULESHOP_STOREFRONT_IMAGE="ghcr.io/mihai888nextlab/ruleshop-storefront:latest"

# AI module (optional). Google Gemini via the OpenAI-compatible endpoint.
# Without a key the AI features degrade to the in-app statistical analysis.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
