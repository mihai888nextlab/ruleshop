{
  "name": "@ruleshop/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Blank Vite storefront bound to one store via RuleShop API key. Static hosting only — talks to the control plane over HTTP.",
  "scripts": {
    "dev": "vite --port 3008",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3008",
    "start": "vite preview --port 3008",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.3.5"
  }
}
